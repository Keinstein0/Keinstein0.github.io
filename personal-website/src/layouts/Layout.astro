---
import background from '../assets/images/cartboardSheet.png';
---


<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style define:vars={{ bgUrl: `url(${background.src})` }}>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

    body {
        background-image: var(--bgUrl); 
        
        background-size: 100%; 
        background-position: center;
        background-repeat: repeat-y;

        display: grid;
        /* 1. Creates as many columns as fit, but forces a wrap if space drops below 280px */
        /* Forces a maximum of 3 columns, but scales down beautifully on small screens */
        grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
        max-width: calc((3 * 280px) + (2 * 80px) + 60px); /* (3 cols * min-width) + (2 gaps * 80px) + padding */
        margin: 0 auto; /* Centers the whole layout on wide screens */
        
        /* 2. Adds space between your sticker and your image */
        gap: 80px; 
        
        /* 3. Centers the items on the screen when they stack */
        justify-items: center;
        align-items: start;
        
        padding: 30px;
        box-sizing: border-box;

        width: 100vw;
        height: 100vh;
    }
</style>
